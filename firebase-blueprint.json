{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User account information, profile details, and role metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "profileImage": { "type": "string" },
        "coverImage": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "website": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "moderator", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "friendsCount": { "type": "number" },
        "followersCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "email"]
    },
    "posts": {
      "title": "Social Posts",
      "description": "User posts including text, images, feelings, and reactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "privacy": { "type": "string", "enum": ["public", "friends", "only_me"] },
        "image": { "type": "string" },
        "feeling": { "type": "string" },
        "createdAt": { "type": "string" },
        "reactions": { "type": "object" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" }
      },
      "required": ["id", "userId", "content", "createdAt"]
    },
    "comments": {
      "title": "Post Comments",
      "description": "Comments and threaded replies on social posts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "reactions": { "type": "object" }
      },
      "required": ["id", "postId", "userId", "content", "createdAt"]
    },
    "friendships": {
      "title": "Friend Relationships",
      "description": "Friend requests and connections between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "senderId", "receiverId", "status"]
    },
    "follows": {
      "title": "User Follows",
      "description": "One-way follower-following social graph",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "followerId", "followingId"]
    },
    "messages": {
      "title": "Direct Messages",
      "description": "Private direct messages between connected users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "senderId", "receiverId", "content"]
    },
    "notifications": {
      "title": "Activity Notifications",
      "description": "Alerts for reactions, comments, messages, and friend requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "actorId": { "type": "string" },
        "type": { "type": "string" },
        "referenceId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "metaText": { "type": "string" }
      },
      "required": ["id", "userId", "actorId", "type"]
    },
    "reports": {
      "title": "Content Moderation Reports",
      "description": "Reports submitted by users regarding posts or accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "reportedUserId": { "type": "string" },
        "reason": { "type": "string" },
        "postId": { "type": "string" },
        "commentId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "reason", "status"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
